# ============================================
# 환경 설정 템플릿 (.env.example)
# ============================================
# 사용 방법:
#   개발: cp .env.example .env.development
#   운영: cp .env.example .env.production
#
# Docker 실행:
#   개발: docker-compose --env-file .env.development up -d
#   운영: docker-compose -f docker-compose.prod.yml --env-file .env.production up -d
# ============================================

# ============================================
# Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=crypto_trading
MYSQL_USER=crypto_user
MYSQL_PASSWORD=your_mysql_password

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=your_redis_password

# ============================================
# Spring Boot Configuration
# 개발: dev / 운영: prod
# ============================================
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Upbit API Configuration
# https://upbit.com/mypage/open_api_management 에서 발급
# ============================================
UPBIT_ACCESS_KEY=your_upbit_access_key
UPBIT_SECRET_KEY=your_upbit_secret_key

# ============================================
# JWT Configuration
# 최소 32자 이상 (256비트)
# 운영 환경에서는 64자 권장 (512비트)
# ============================================
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=1800000

# ============================================
# Encryption Configuration (AES-256)
# 정확히 32자 필수!
# ============================================
AES_SECRET_KEY=your_32_character_aes_secret_key

# ============================================
# Discord Webhook Configuration
# ============================================
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# ============================================
# Discord Bot Configuration
# ============================================
DISCORD_BOT_TOKEN=your_discord_bot_token

# ============================================
# Email Configuration (Gmail SMTP)
# Gmail 앱 비밀번호 사용 필요
# ============================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================
# ChatGPT API Configuration (Optional)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Production-specific Settings (운영 환경만)
# ============================================
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# SSL_ENABLED=false
# SSL_DOMAIN=yourdomain.com